{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/invitation/**",
              "components/layout/**",
              "ui_kits/wedding_card/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Be Vietnam Pro|Cormorant Garamond|Great Vibes))/i]",
        "message": "Font not provided by the design system. Available: Be Vietnam Pro, Cormorant Garamond, Great Vibes."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|fullWidth|disabled|href|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, fullWidth, disabled, href, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|soft|ghost|light|goldline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'soft' | 'ghost' | 'light' | 'goldline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|align|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, align, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:frame|plain|paper|tint)$/]",
        "message": "<Card> variant must be one of 'frame' | 'plain' | 'paper' | 'tint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<Card> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, defaultChecked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:to|labels|variant|style|key|ref|className|style|children)$/]",
        "message": "<Countdown> doesn't accept that prop. Declared props: to, labels, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|boxed)$/]",
        "message": "<Countdown> variant must be one of 'plain' | 'boxed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:weekday|day|month|year|size|style|key|ref|className|style|children)$/]",
        "message": "<DateBlock> doesn't accept that prop. Declared props: weekday, day, month, year, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<DateBlock> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|eyebrow|title|children|footer|width|style|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, eyebrow, title, children, footer, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|label|width|color|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: variant, label, width, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ornament|line|text|dots)$/]",
        "message": "<Divider> variant must be one of 'ornament' | 'line' | 'text' | 'dots'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tag|tagTone|title|time|weekday|day|month|year|lunar|venue|address|mapHref|cardVariant|style|key|ref|className|style|children)$/]",
        "message": "<EventCard> doesn't accept that prop. Declared props: tag, tagTone, title, time, weekday, day, month, year, lunar, venue, address, mapHref, cardVariant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventCard'] > JSXAttribute[name.name='tagTone'] > Literal[value!=/^(?:red|gold|blush|sage|hy|neutral)$/]",
        "message": "<EventCard> tagTone must be one of 'red' | 'gold' | 'blush' | 'sage' | 'hy' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventCard'] > JSXAttribute[name.name='cardVariant'] > Literal[value!=/^(?:frame|plain|paper|tint)$/]",
        "message": "<EventCard> cardVariant must be one of 'frame' | 'plain' | 'paper' | 'tint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|active|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, active, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|glass|solid|plain)$/]",
        "message": "<IconButton> variant must be one of 'outline' | 'glass' | 'solid' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|defaultValue|onChange|type|multiline|rows|hint|error|disabled|id|name|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, value, defaultValue, onChange, type, multiline, rows, hint, error, disabled, id, name, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|tel|email|number)$/]",
        "message": "<Input> type must be one of 'text' | 'tel' | 'email' | 'number'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute > JSXIdentifier[name!=/^(?:a|b|size|ring|color|style|key|ref|className|style|children)$/]",
        "message": "<Monogram> doesn't accept that prop. Declared props: a, b, size, ring, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|shape|ratio|matted|placeholder|width|style|key|ref|className|style|children)$/]",
        "message": "<PhotoFrame> doesn't accept that prop. Declared props: src, alt, shape, ratio, matted, placeholder, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:rect|arch|circle|oval)$/]",
        "message": "<PhotoFrame> shape must be one of 'rect' | 'arch' | 'circle' | 'oval'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<RadioOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|eyebrowStyle|ornament|align|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, subtitle, eyebrowStyle, ornament, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='eyebrowStyle'] > Literal[value!=/^(?:script|label)$/]",
        "message": "<SectionHeading> eyebrowStyle must be one of 'script' | 'label'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<SectionHeading> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SongHy'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|ring|style|key|ref|className|style|children)$/]",
        "message": "<SongHy> doesn't accept that prop. Declared props: size, tone, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SongHy'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:hy|gold)$/]",
        "message": "<SongHy> tone must be one of 'hy' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|gold|blush|sage|hy|neutral)$/]",
        "message": "<Tag> tone must be one of 'red' | 'gold' | 'blush' | 'sage' | 'hy' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|message|tone|icon|duration|onClose|position|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: open, message, tone, icon, duration, onClose, position, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|success|error)$/]",
        "message": "<Toast> tone must be one of 'default' | 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:fixed|inline)$/]",
        "message": "<Toast> position must be one of 'fixed' | 'inline'."
      }
    ]
  },
